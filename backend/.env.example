# ── Gemini API ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Flint MCP ──────────────────────────────────────────────
FLINT_MCP_URL=https://flint.data-formulator.ai/mcp

# ── Gemini Model ───────────────────────────────────────────
GEMINI_MODEL_ID=gemini-3.5-flash

# ── Server ─────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
